# Shared database for LIVE class records (used when students are signed in).
# On Vercel these are added automatically when you connect an Upstash Redis store
# to the project (Vercel dashboard > Storage / Marketplace > Upstash Redis > Connect Project).
# For local testing you may copy them from the Upstash dashboard into .env.local.
KV_REST_API_URL=
KV_REST_API_TOKEN=
