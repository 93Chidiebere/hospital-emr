# ---- Database for live class records and reports (Turso) ----
# Turso dashboard > your database > "Connect" shows the URL and lets you create a token.
TURSO_DATABASE_URL=libsql://your-database-name-yourorg.turso.io
TURSO_AUTH_TOKEN=

# ---- Teacher password (checked on the server) ----
# The password teachers type on the Teachers / Admin sign-in screen.
# It also unlocks the Reports page and the "New Session" button.
TEACHER_PASSWORD=
# Optional: a long random text used to sign the teacher login cookie.
AUTH_SECRET=
