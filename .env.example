# ---- Database (Turso) ----
# Turso dashboard > your database > "Connect" shows the URL and lets you create a token.
TURSO_DATABASE_URL=libsql://your-database-name-yourorg.turso.io
TURSO_AUTH_TOKEN=

# ---- Sign-in security (REQUIRED) ----
# A long random text that signs the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# The password teachers type on the Teachers / Admin tab. Use something NEW and private.
# Do NOT use the old "Pass@word1": it is published in the public GitHub code.
TEACHER_PASSWORD=
